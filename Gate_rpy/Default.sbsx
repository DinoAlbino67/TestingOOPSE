				<_modifiedTime type="a">6.9.2026::16:6:45</_modifiedTime>
				<_body type="a">bool receiver_ok = itsReceiver.is_ok();%0D
bool detector_ok = itsDetector.is_ok();%0D
bool drive_ok=itsDrive.is_ok();%0D
bool lamp_ok=itsLamp.is_ok();%0D
bool state_indication;%0D
bool all_ok = receiver_ok &amp;&amp; detector_ok &amp;&amp; drive_ok &amp;&amp;(state_indication ? lamp_ok:true);%0D
if(all_ok)%0D
	GEN(evOK());%0D
else%0D
	GEN(evFAIL());		</_body>
			</IAction>
			</_entryAction>
		</IState>
