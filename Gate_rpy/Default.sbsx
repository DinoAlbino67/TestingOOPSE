		<IRequirement type="e">
			<_id type="a">GUID 2d030c18-e262-45b5-896c-4e5b17e5121d</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">State indication</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">State indication%0D
Optionally, the lamp will be blinking, possibly with different rate in case of opening and closing the gate</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">6.2.2026::10:30:28</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID 21bb0152-8b09-42c2-ac84-b1543d7bd7dc</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">Stopping</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Stopping%0D
Stopping the gate may result from reachiong one of the end positions or the occurence of a collision.%0D
The procedure should in order:%0D
1. Switch off the drice%0D
2. Turn off the collsion detector%0D
3. Optionally, turn off the signal lamp</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">6.2.2026::10:33:12</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID 66637d5d-d2ae-4094-893e-df7998ea3c90</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">Testing</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">Testing involves sending the 'is_ok()' message to the modules and reading the returned value. If the value is not returned within the specified time, the test is considered failed</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">6.2.2026::10:16:40</_modifiedTime>
		</IRequirement>
