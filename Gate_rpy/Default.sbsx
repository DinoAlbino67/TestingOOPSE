				<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
				<_modifiedTime type="a">1.1.1970::1:0:0</_modifiedTime>
				<_body type="a">receiver_ok = itsReceiver.is_ok();%0D
detector_ok = itsDetector.is_ok();%0D
drive_ok=itsDrive.is_ok();%0D
lamp_ok=itsLamp.is_ok();%0D
bool all_ok = receiver_ok &amp;&amp; detector_ok &amp;&amp; drive_ok &amp;&amp;(state_indication ? lamp_ok:true);%0D
if(all_ok)%0D
	GEN(evOK());%0D
else%0D
	GEN(evFAIL());		</_body>
			</IAction>
